<Window x:Class="DataAcquisition.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Acquisition System" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Menu -->
            <RowDefinition Height="50"/>
            <!-- Port Controls -->
            <RowDefinition Height="Auto"/>
            <!-- App Buttons -->
            <RowDefinition Height="*"/>
            <!-- Main Display Area -->
            <RowDefinition Height="Auto"/>
            <!-- Bottom Buttons -->
            <RowDefinition Height="230"/>
            <!-- Experiments & Procedure -->
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Left Panel -->
            <ColumnDefinition Width="10"/>
            <!-- Spacing -->
            <ColumnDefinition Width="*"/>
            <!-- Center Main Display -->
            <ColumnDefinition Width="10"/>
            <!-- Spacing -->
            <ColumnDefinition Width="320"/>
            <!-- Right Panel -->
        </Grid.ColumnDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Background="#FF2196F3" Foreground="White">
            <MenuItem Header="Settings" Foreground="White">
                <MenuItem Header="Port Settings" Click="PortSettings_Click"/>
            </MenuItem>
            <MenuItem Header="Files" Foreground="White">
                <MenuItem Header="Manual" Click="OpenManual_Click">
                    <MenuItem.Icon>
                        <Image Source="Assets/manual.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Config" Click="OpenConfig_Click">
                    <MenuItem.Icon>
                        <Image Source="Assets/config.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="About" Click="About_Click" Foreground="White"/>
        </Menu>

        <!-- Port Controls -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" 
                    Orientation="Horizontal" VerticalAlignment="Center" 
                    HorizontalAlignment="Center" Background="#FFE3F2FD">
            <Label Content="COM Port:" VerticalAlignment="Center" Margin="10,0"/>
            <ComboBox x:Name="ComPortComboBox" Width="100" Height="25" Margin="5,0"/>
            <Label Content="Device Address:" VerticalAlignment="Center" Margin="10,0"/>
            <TextBox x:Name="DeviceAddressTextBox" Width="80" Height="25" Margin="5,0" Text="1"/>
            <Button x:Name="StartStopButton" Content="Start" Width="80" Height="30" 
                    Margin="20,0" Click="StartStop_Click" Background="#FF4CAF50" 
                    Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <!-- App Buttons -->
        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,10">
            <Button Content="FUNCTION GENERATOR" Width="180" Height="40" 
                    Margin="10,0" FontWeight="Bold" Background="#FFFF9800" 
                    Foreground="White" Click="FunctionGenerator_Click"/>
            <Button Content="OSCILLOSCOPE" Width="180" Height="40" 
                    Margin="10,0" FontWeight="Bold" Background="#FF9C27B0" 
                    Foreground="White" Click="Oscilloscope_Click"/>
        </StackPanel>

        <!-- Left Panel: Logic Switches -->
        <GroupBox Grid.Row="3" Grid.Column="0" Header="Logic Switches" 
                  Margin="5" Padding="5">
            <StackPanel>
                <UniformGrid Columns="4" Rows="2">
                    <ToggleButton x:Name="OUT0" Content="OUT0" Style="{StaticResource ToggleButtonStyle}" Click="PinToggle_Click"/>
                    <ToggleButton x:Name="OUT1" Content="OUT1" Style="{StaticResource ToggleButtonStyle}" Click="PinToggle_Click"/>
                    <ToggleButton x:Name="OUT2" Content="OUT2" Style="{StaticResource ToggleButtonStyle}" Click="PinToggle_Click"/>
                    <ToggleButton x:Name="OUT3" Content="OUT3" Style="{StaticResource ToggleButtonStyle}" Click="PinToggle_Click"/>
                    <ToggleButton x:Name="OUT4" Content="OUT4" Style="{StaticResource ToggleButtonStyle}" Click="PinToggle_Click"/>
                    <ToggleButton x:Name="OUT5" Content="OUT5" Style="{StaticResource ToggleButtonStyle}" Click="PinToggle_Click"/>
                    <ToggleButton x:Name="OUT6" Content="OUT6" Style="{StaticResource ToggleButtonStyle}" Click="PinToggle_Click"/>
                    <ToggleButton x:Name="OUT7" Content="OUT7" Style="{StaticResource ToggleButtonStyle}" Click="PinToggle_Click"/>
                </UniformGrid>

                <!-- Power Supply Slider -->
                <GroupBox Header="Power Supply (0-5V)" Margin="0,20,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="+5V" VerticalAlignment="Top" 
                                   Margin="5,0" FontWeight="Bold" Foreground="#FFFF5722"/>
                        
                        <Slider x:Name="PowerSupplySlider" Grid.Column="1" 
                                Orientation="Vertical" Minimum="0" Maximum="5" 
                                Value="0" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                Height="150" VerticalAlignment="Center" 
                                ValueChanged="PowerSupplySlider_ValueChanged"/>
                        
                        <TextBlock Grid.Column="0" Text="0V" VerticalAlignment="Bottom" 
                                   Margin="5,0" FontWeight="Bold"/>
                        
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Voltage:" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="VoltageDisplay" Text="0.0 V" 
                                       FontSize="16" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Margin="0,5"
                                       Foreground="#FFFF5722"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </GroupBox>

        <!-- Center Main Display Area -->
        <Border Grid.Row="3" Grid.Column="2" BorderBrush="#FF2196F3" 
                BorderThickness="2" Margin="5" Background="White">
            <Grid>
                <TextBlock Text="Main Display Area" FontSize="24" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                           Foreground="#FFBDBDBD"/>
                <!-- Placeholder for Function Generator or Oscilloscope content -->
                <Frame x:Name="MainContentFrame" NavigationUIVisibility="Hidden"/>
            </Grid>
        </Border>

        <!-- Right Panel: Logic Indicators -->
        <StackPanel Grid.Row="3" Grid.Column="4" Margin="5">
            <!-- Digital Inputs -->
            <GroupBox Header="Logic Indicators" Padding="5">
                <UniformGrid Columns="2" Rows="4">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Ellipse x:Name="IN0" Style="{StaticResource LedIndicator}" Fill="Gray"/>
                        <TextBlock Text="IN0" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Ellipse x:Name="IN1" Style="{StaticResource LedIndicator}" Fill="Gray"/>
                        <TextBlock Text="IN1" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Ellipse x:Name="IN2" Style="{StaticResource LedIndicator}" Fill="Gray"/>
                        <TextBlock Text="IN2" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Ellipse x:Name="IN3" Style="{StaticResource LedIndicator}" Fill="Gray"/>
                        <TextBlock Text="IN3" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Ellipse x:Name="IN4" Style="{StaticResource LedIndicator}" Fill="Gray"/>
                        <TextBlock Text="IN4" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Ellipse x:Name="IN5" Style="{StaticResource LedIndicator}" Fill="Gray"/>
                        <TextBlock Text="IN5" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Ellipse x:Name="IN6" Style="{StaticResource LedIndicator}" Fill="Gray"/>
                        <TextBlock Text="IN6" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Ellipse x:Name="IN7" Style="{StaticResource LedIndicator}" Fill="Gray"/>
                        <TextBlock Text="IN7" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>
                </UniformGrid>
            </GroupBox>

            <!-- Digital Meters -->
            <GroupBox Header="Digital Meters" Margin="0,10,0,0" Padding="5">
                <StackPanel>
                    <Border Style="{StaticResource MeterBorder}">
                        <StackPanel>
                            <TextBlock Text="DC Voltmeter" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DCVoltmeter" Text="0.00 V" FontSize="18" 
                                       HorizontalAlignment="Center" Margin="0,5"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Style="{StaticResource MeterBorder}">
                        <StackPanel>
                            <TextBlock Text="AC Voltmeter" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ACVoltmeter" Text="0.00 V" FontSize="18" 
                                       HorizontalAlignment="Center" Margin="0,5"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Style="{StaticResource MeterBorder}">
                        <StackPanel>
                            <TextBlock Text="DC Ammeter" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DCAmmeter" Text="0.00 mA" FontSize="18" 
                                       HorizontalAlignment="Center" Margin="0,5"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Style="{StaticResource MeterBorder}">
                        <StackPanel>
                            <TextBlock Text="AC Ammeter" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ACAmmeter" Text="0.00 mA" FontSize="18" 
                                       HorizontalAlignment="Center" Margin="0,5"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" 
                    Orientation="Horizontal" HorizontalAlignment="Right" 
                    Margin="10">
            <Button Content="Check Results" Width="120" Height="35" 
                    Margin="5" Click="CheckResults_Click" 
                    Background="#FF2196F3" Foreground="White" FontWeight="Bold"/>
            <Button Content="Save CSV" Width="120" Height="35" 
                    Margin="5" Click="SaveCSV_Click" 
                    Background="#FF4CAF50" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <!-- Experiments & Procedure -->
        <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Expander Grid.Column="0" Header="Experiments" IsExpanded="True" 
                      Margin="5" Background="#FFF5F5F5">
                <TreeView x:Name="ExperimentsTreeView" 
                          SelectedItemChanged="ExperimentsTreeView_SelectedItemChanged">
                    <TreeViewItem Header="Basic Experiments">
                        <TreeViewItem Header="LED Blinking"/>
                        <TreeViewItem Header="Switch Interface"/>
                        <TreeViewItem Header="Seven Segment Display"/>
                    </TreeViewItem>
                    <TreeViewItem Header="Analog Experiments">
                        <TreeViewItem Header="ADC Reading"/>
                        <TreeViewItem Header="DAC Output"/>
                        <TreeViewItem Header="Temperature Sensor"/>
                    </TreeViewItem>
                    <TreeViewItem Header="Communication">
                        <TreeViewItem Header="UART Communication"/>
                        <TreeViewItem Header="I2C Interface"/>
                        <TreeViewItem Header="SPI Interface"/>
                    </TreeViewItem>
                </TreeView>
            </Expander>

            <Expander Grid.Column="1" Header="Procedure" IsExpanded="True" 
                      Margin="5" Background="#FFF5F5F5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ProcedureTextBlock" TextWrapping="Wrap" 
                               Padding="10" Text="Select an experiment to view the procedure."/>
                </ScrollViewer>
            </Expander>
        </Grid>
    </Grid>
</Window>
