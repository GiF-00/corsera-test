<Window x:Class="DataAcquisition.Windows.PortSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataAcquisition.Windows"
        mc:Ignorable="d"
        Title="Port Settings"
        Width="600" MinWidth="550" MaxWidth="650"
        Height="620" MinHeight="620" MaxHeight="680"
        FontSize="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="198*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Password View -->
        <Border x:Name="PasswordView" Visibility="Hidden" Grid.RowSpan="2" Panel.ZIndex="100" Background="Gray">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Enter password to proceed further" Grid.Row="1" Grid.Column="1" Foreground="White" FontSize="16" />
                <PasswordBox x:Name="PasswordText" Grid.Row="3" Grid.Column="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" KeyDown="OnPasswordTextKeyDown" />
                <TextBlock x:Name="PasswordValidation" Grid.Row="5" Grid.Column="1" Foreground="#FFFBD6D6" />
                <StackPanel Grid.Row="7" Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="PasswordOkButton" Content="Ok" Width="120" Click="OnPasswordOkButtonClicked" IsDefault="True" Margin="2,2,2,2" />
                    <Button x:Name="PasswordCancelButton" Content="Cancel" Width="120" Click="OnPasswordCancelButtonClicked" IsCancel="True" Margin="2,2,2,2" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl>
            <TabItem Header="Serial">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LeftOptionsPanel"
                                    Margin="3,3,0,3">

                            <!-- Baud-rate -->
                            <TextBlock x:Name="BaudRateHeading" TextWrapping="Wrap" Text="Baud Rate" Margin="0,10,0,0"/>
                            <ComboBox x:Name="BaudRateComboBox" HorizontalAlignment="Stretch" Margin="0,5,0,0" />

                            <!-- Data Bits -->
                            <TextBlock x:Name="DataBitsHeading" TextWrapping="Wrap" Text="Data Bits" Margin="0,10,0,0" />
                            <ComboBox x:Name="DataBitsComboBox" HorizontalAlignment="Stretch" Margin="0,5,0,0" />

                            <!-- Parity -->
                            <TextBlock x:Name="ParityHeading" TextWrapping="Wrap" Text="Parity" Margin="0,10,0,0" />
                            <ComboBox x:Name="ParityComboBox" HorizontalAlignment="Stretch" Margin="0,5,0,0" />

                            <!-- Stop Bits -->
                            <TextBlock x:Name="StopBitsHeading" TextWrapping="Wrap" Text="Stop Bits" Margin="0,10,0,0" />
                            <ComboBox x:Name="StopBitsComboBox" HorizontalAlignment="Stretch" Margin="0,5,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Data Values">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="150*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="150*"/>
                        <ColumnDefinition Width="150*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Registers' Start Address -->
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.ColumnSpan="6" >
                        <Label Content="Start address: " />
                        <TextBox x:Name="RegistersStartAddress" Width="100" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                    </StackPanel>
                    
                    <!-- Borders / Backgrounds -->
                    <Border Tag="Correction Factors" Grid.Row="2" Grid.Column="1" Grid.RowSpan="17" Grid.ColumnSpan="4" Background="#FFF3FFE6" CornerRadius="5,5,5,5" />
                    <Border Tag="Correction Factors" Grid.Row="2" Grid.Column="5" Grid.RowSpan="17" Grid.ColumnSpan="1" Background="#FFE6FFFF" CornerRadius="5,5,5,5" />
                    
                    <!-- Register Settings -->
                    <Label Grid.Row="1" HorizontalAlignment="Center" Content="Register Settings" FontWeight="Bold" Grid.Column="0" Width="Auto" Grid.ColumnSpan="6" />
                    <Label Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" Content="Correction factors" FontStyle="Italic" Width="Auto" Grid.ColumnSpan="4" />
                    <Label Grid.Row="2" Grid.Column="5" HorizontalAlignment="Center" Content="Measurement Units" FontStyle="Italic" Width="Auto" />

                    <!-- Register Names -->
                    <Label Grid.Row="3" Content="A1" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,2,0,2" />
                    <Label Grid.Row="4" Content="A2" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,2,0,2" />
                    <Label Grid.Row="5" Content="A3" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,2,0,2" />
                    <Label Grid.Row="6" Content="A4" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,2,0,2" />
                    <Label Grid.Row="7" Content="A5" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,2,0,2" />
                    <Label Grid.Row="8" Content="A6" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,2,0,2" />
                    <Label Grid.Row="9" Content="A7" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,2,0,2" />
                    <Label Grid.Row="10" Content="A8" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,2,0,2" />
                    <Label Grid.Row="11" Content="A9" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,2,0,2" />
                    <Label Grid.Row="12" Content="A10" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,2,0,2" />
                    <Label Grid.Row="13" Content="A11" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,2,0,2" />
                    <Label Grid.Row="14" Content="A12" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,2,0,2" />
                    <Label Grid.Row="15" Content="A13" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,2,0,2" />
                    <Label Grid.Row="16" Content="A14" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,2,0,2" />
                    <Label Grid.Row="17" Content="A15" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,2,0,2" />
                    <Label Grid.Row="18" Content="A16" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,2,0,2" />

                    <!-- Initial Multiplication Factor -->
                    <Label Grid.Row="3" Grid.Column="1" Content=" ÷ 1000 x " HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="4" Grid.Column="1" Content=" ÷ 1000 x " HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="5" Grid.Column="1" Content=" ÷ 1000 x " HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="6" Grid.Column="1" Content=" ÷ 1000 x " HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="7" Grid.Column="1" Content=" ÷ 1000 x " HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="8" Grid.Column="1" Content=" ÷ 1000 x " HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="9" Grid.Column="1" Content=" ÷ 1000 x " HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="10" Grid.Column="1" Content=" ÷ 1000 x " HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="11" Grid.Column="1" Content=" ÷ 1000 x " HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="12" Grid.Column="1" Content=" ÷ 1000 x " HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="13" Grid.Column="1" Content=" ÷ 1000 x " HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="14" Grid.Column="1" Content=" ÷ 1000 x " HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="15" Grid.Column="1" Content=" ÷ 1000 x " HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="16" Grid.Column="1" Content=" ÷ 1000 x " HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="17" Grid.Column="1" Content=" ÷ 1000 x " HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="18" Grid.Column="1" Content=" ÷ 1000 x " HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />

                    <!-- Multiplication Factor -->
                    <TextBox Grid.Row="3" Grid.Column="2" x:Name="MultiplicationFactorA1" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="4" Grid.Column="2" x:Name="MultiplicationFactorA2" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="5" Grid.Column="2" x:Name="MultiplicationFactorA3" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="6" Grid.Column="2" x:Name="MultiplicationFactorA4" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="7" Grid.Column="2" x:Name="MultiplicationFactorA5" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="8" Grid.Column="2" x:Name="MultiplicationFactorA6" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="9" Grid.Column="2" x:Name="MultiplicationFactorA7" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="10" Grid.Column="2" x:Name="MultiplicationFactorA8" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="11" Grid.Column="2" x:Name="MultiplicationFactorA9" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="12" Grid.Column="2" x:Name="MultiplicationFactorA10" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="13" Grid.Column="2" x:Name="MultiplicationFactorA11" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="14" Grid.Column="2" x:Name="MultiplicationFactorA12" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="15" Grid.Column="2" x:Name="MultiplicationFactorA13" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="16" Grid.Column="2" x:Name="MultiplicationFactorA14" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="17" Grid.Column="2" x:Name="MultiplicationFactorA15" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="18" Grid.Column="2" x:Name="MultiplicationFactorA16" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />

                    <!-- Addition Factor Symbol -->
                    <Label Grid.Row="3" Grid.Column="3" Content="+" HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="4" Grid.Column="3" Content="+" HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="5" Grid.Column="3" Content="+" HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="6" Grid.Column="3" Content="+" HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="7" Grid.Column="3" Content="+" HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="8" Grid.Column="3" Content="+" HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="9" Grid.Column="3" Content="+" HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="10" Grid.Column="3" Content="+" HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="11" Grid.Column="3" Content="+" HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="12" Grid.Column="3" Content="+" HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="13" Grid.Column="3" Content="+" HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="14" Grid.Column="3" Content="+" HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="15" Grid.Column="3" Content="+" HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="16" Grid.Column="3" Content="+" HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="17" Grid.Column="3" Content="+" HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />
                    <Label Grid.Row="18" Grid.Column="3" Content="+" HorizontalAlignment="Center" FontWeight="Bold" FontStyle="Italic" Margin="0,2,0,2" />

                    <!-- Offsets -->
                    <TextBox Grid.Row="3" Grid.Column="4" x:Name="OffsetA1" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="4" Grid.Column="4" x:Name="OffsetA2" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="5" Grid.Column="4" x:Name="OffsetA3" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="6" Grid.Column="4" x:Name="OffsetA4" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="7" Grid.Column="4" x:Name="OffsetA5" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="8" Grid.Column="4" x:Name="OffsetA6" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="9" Grid.Column="4" x:Name="OffsetA7" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="10" Grid.Column="4" x:Name="OffsetA8" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="11" Grid.Column="4" x:Name="OffsetA9" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="12" Grid.Column="4" x:Name="OffsetA10" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="13" Grid.Column="4" x:Name="OffsetA11" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="14" Grid.Column="4" x:Name="OffsetA12" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="15" Grid.Column="4" x:Name="OffsetA13" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="16" Grid.Column="4" x:Name="OffsetA14" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="17" Grid.Column="4" x:Name="OffsetA15" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="18" Grid.Column="4" x:Name="OffsetA16" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />

                    <!-- DisplayUnit -->
                    <TextBox Grid.Row="3" Grid.Column="5" x:Name="DisplayUnitA1" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="4" Grid.Column="5" x:Name="DisplayUnitA2" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="5" Grid.Column="5" x:Name="DisplayUnitA3" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="6" Grid.Column="5" x:Name="DisplayUnitA4" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="7" Grid.Column="5" x:Name="DisplayUnitA5" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="8" Grid.Column="5" x:Name="DisplayUnitA6" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="9" Grid.Column="5" x:Name="DisplayUnitA7" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="10" Grid.Column="5" x:Name="DisplayUnitA8" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="11" Grid.Column="5" x:Name="DisplayUnitA9" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="12" Grid.Column="5" x:Name="DisplayUnitA10" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="13" Grid.Column="5" x:Name="DisplayUnitA11" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="14" Grid.Column="5" x:Name="DisplayUnitA12" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="15" Grid.Column="5" x:Name="DisplayUnitA13" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="16" Grid.Column="5" x:Name="DisplayUnitA14" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="17" Grid.Column="5" x:Name="DisplayUnitA15" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />
                    <TextBox Grid.Row="18" Grid.Column="5" x:Name="DisplayUnitA16" Width="Auto" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,2,2,2" />

                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="CancelButton" Margin="2,2,2,2" Content="Cancel" Grid.Column="1" Click="OnCancelClick" />
            <Button x:Name="OkButton" Margin="2,2,2,2" Content="Ok" Grid.Column="2" Click="OnOkClick" />
        </Grid>
    </Grid>
</Window>
