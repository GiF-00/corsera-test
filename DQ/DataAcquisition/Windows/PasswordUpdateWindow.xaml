<Window x:Class="DataAcquisition.Windows.PasswordUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataAcquisition.Windows"
        mc:Ignorable="d"
        Title="Update Password"
        Width="650" MinWidth="550"
        Height="650" MinHeight="620"
        FontSize="14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Password View -->
        <Border x:Name="PasswordView" Visibility="Hidden" Grid.RowSpan="2" Panel.ZIndex="100" Background="Gray">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Enter password to proceed further" Grid.Row="1" Grid.Column="1" Foreground="White" FontSize="16" />
                <PasswordBox x:Name="PasswordText" Grid.Row="3" Grid.Column="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" KeyDown="OnPasswordTextKeyDown" />
                <TextBlock x:Name="PasswordValidation" Grid.Row="5" Grid.Column="1" Foreground="#FFFBD6D6" />
                <StackPanel Grid.Row="7" Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="PasswordOkButton" Content="Ok" Width="120" Click="OnPasswordOkButtonClicked" IsDefault="True" Margin="2,2,2,2" />
                    <Button x:Name="PasswordCancelButton" Content="Cancel" Width="120" Click="OnPasswordCancelButtonClicked" IsCancel="True" Margin="2,2,2,2" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Functions -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="1" Margin="5,10,5,5" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                        <TextBlock Text="Current password" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="CurrentPasswordText" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="35" KeyDown="OnPasswordChangeBoxesKeyDown" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="0,20,0,20">
                        <TextBlock Text="New password" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="NewPasswordText" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="35" Margin="0,0,0,5" KeyDown="OnPasswordChangeBoxesKeyDown" />

                        <TextBlock Text="New password" Margin="0,5,0,5"/>
                        <PasswordBox x:Name="NewPasswordVerifiedText" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="35" Margin="0,0,0,5" KeyDown="OnPasswordChangeBoxesKeyDown" />
                    </StackPanel>

                    <TextBlock x:Name="PasswordChangeValidation" Visibility="Collapsed" Text="Old password" Margin="0,15,0,15" HorizontalAlignment="Center" Foreground="Red" FontSize="16"/>

                    <Button x:Name="PasswordChangeProceed" Content="Proceed" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="35" Margin="0,15,0,0" Click="OnPasswordChangeProceedClicked" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="90"/>
            </Grid.ColumnDefinitions>

            <Button Margin="2,2,2,2" Content="Close" Grid.Column="1" Click="OnCloseButtonClick" />
            <Button Margin="2,2,2,2" Content="Ok" Grid.Column="2" Click="OnOkButtonClick" />
        </Grid>
    </Grid>
</Window>
